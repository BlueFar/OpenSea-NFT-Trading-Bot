# OpenSea API Key (Required for live API calls)
# Get a free key at https://docs.opensea.io/reference/api-keys
# or generate an instant key: curl -X POST https://api.opensea.io/api/v2/auth/keys
OPENSEA_API_KEY=your_opensea_api_key_here

# Bot operational timezone (default: Asia/Kolkata)
BOT_TIMEZONE=Asia/Kolkata

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
